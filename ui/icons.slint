// Hand-drawn icons (pause = two separate bars, never a solid block)
// (24×24 viewbox). Each icon is a filled layer plus a stroked layer.

export global IconSet {
    public pure function fill(name: string) -> string {
        if (name == "play") { return "M8 5.2 L19.2 12 L8 18.8 Z"; }
        if (name == "pause") { return "M6.6 5 H9.6 V19 H6.6 Z M14.4 5 H17.4 V19 H14.4 Z"; }
        if (name == "prev") { return "M5.5 5 H8 V19 H5.5 Z M19 5.4 V18.6 L9.2 12 Z"; }
        if (name == "next") { return "M16 5 H18.5 V19 H16 Z M5 5.4 V18.6 L14.8 12 Z"; }
        if (name == "volume" || name == "mute") { return "M3.5 9.2 H7.4 L12.6 5.2 V18.8 L7.4 14.8 H3.5 Z"; }
        if (name == "info") { return "M10.8 7.6 A1.2 1.2 0 1 0 13.2 7.6 A1.2 1.2 0 1 0 10.8 7.6 Z"; }
        if (name == "list") { return "M3.3 6.5 A1.2 1.2 0 1 0 5.7 6.5 A1.2 1.2 0 1 0 3.3 6.5 Z M3.3 12 A1.2 1.2 0 1 0 5.7 12 A1.2 1.2 0 1 0 3.3 12 Z M3.3 17.5 A1.2 1.2 0 1 0 5.7 17.5 A1.2 1.2 0 1 0 3.3 17.5 Z"; }
        if (name == "disk") { return ""; }
        if (name == "playlist") { return "M13.6 16.4 A2.4 2.4 0 1 0 18.4 16.4 A2.4 2.4 0 1 0 13.6 16.4 Z"; }
        if (name == "note") { return "M3.8 17.2 A2.6 2.6 0 1 0 9 17.2 A2.6 2.6 0 1 0 3.8 17.2 Z M13.8 15.2 A2.6 2.6 0 1 0 19 15.2 A2.6 2.6 0 1 0 13.8 15.2 Z"; }
        if (name == "settings") { return "M6.4 7 A2.6 2.6 0 1 0 11.6 7 A2.6 2.6 0 1 0 6.4 7 Z M12.4 17 A2.6 2.6 0 1 0 17.6 17 A2.6 2.6 0 1 0 12.4 17 Z"; }
        return "";
    }

    public pure function stroke(name: string) -> string {
        if (name == "volume") { return "M15.6 9 Q17.6 12 15.6 15 M18.6 6 Q22.4 12 18.6 18"; }
        if (name == "mute") { return "M15 8.5 L21.5 15 M21.5 8.5 L15 15"; }
        if (name == "search") { return "M4.5 10.5 A6 6 0 1 0 16.5 10.5 A6 6 0 1 0 4.5 10.5 M15 15 L20 20"; }
        if (name == "settings") { return "M4 7 H20 M4 17 H20"; }
        if (name == "info") { return "M3.5 12 A8.5 8.5 0 1 0 20.5 12 A8.5 8.5 0 1 0 3.5 12 M12 10.8 V16.6"; }
        if (name == "shuffle") { return "M3.5 7 H7 C11.5 7 12.5 17 17 17 H20 M3.5 17 H7 C8.9 17 10.1 15.3 11 13.3 M13 10.7 C13.9 8.7 15.1 7 17 7 H20 M17.5 4.5 L20 7 L17.5 9.5 M17.5 14.5 L20 17 L17.5 19.5"; }
        if (name == "repeat") { return "M16.5 3.5 L19.5 6.5 L16.5 9.5 M4.5 11.5 V10 A3.5 3.5 0 0 1 8 6.5 H19.5 M7.5 20.5 L4.5 17.5 L7.5 14.5 M19.5 12.5 V14 A3.5 3.5 0 0 1 16 17.5 H4.5"; }
        if (name == "queue-next") { return "M4 6 H14 M4 11 H11 M4 16 H9 M14 13 L19 16.5 L14 20 Z"; }
        if (name == "chevron-down") { return "M6.5 9.5 L12 15 L17.5 9.5"; }
        if (name == "pin") { return "M9.5 4 H14.5 M10.5 4 V9.5 L7.5 13.5 H16.5 L13.5 9.5 V4 M12 13.5 V20"; }
        if (name == "detach") { return "M13.5 4 H20 V10.5 M20 4 L12 12 M17.5 14 V19.5 H4.5 V6.5 H10"; }
        if (name == "attach") { return "M4 5 H20 V19 H4 Z M14.5 5 V19"; }
        if (name == "win-min") { return "M6 12 H18"; }
        if (name == "win-max") { return "M6.5 6.5 H17.5 V17.5 H6.5 Z"; }
        if (name == "win-restore") { return "M6 9 H15 V18 H6 Z M9 9 V6 H18 V15 H15"; }
        if (name == "win-close") { return "M6.5 6.5 L17.5 17.5 M17.5 6.5 L6.5 17.5"; }
        if (name == "close") { return "M6.5 6.5 L17.5 17.5 M17.5 6.5 L6.5 17.5"; }
        if (name == "plus") { return "M12 5 V19 M5 12 H19"; }
        if (name == "folder") { return "M3.5 6.5 H9.6 L11.6 8.8 H20.5 V18.5 H3.5 Z"; }
        if (name == "list") { return "M8.5 6.5 H20 M8.5 12 H20 M8.5 17.5 H20"; }
        if (name == "disk") { return "M3.5 4.5 H20.5 V15.5 H3.5 Z M8.5 20 H15.5 M12 15.5 V20"; }
        if (name == "cloud") { return "M7.2 18.5 H17.2 A3.9 3.9 0 0 0 17.6 10.7 A5.6 5.6 0 0 0 6.9 10.3 A4.1 4.1 0 0 0 7.2 18.5 Z"; }
        if (name == "playlist") { return "M4 6.5 H14 M4 11 H14 M4 15.5 H10 M18.4 5 V16.4"; }
        if (name == "note") { return "M9 17.2 V6.4 L19 4.4 V15.2"; }
        if (name == "refresh") { return "M19.5 12.5 A7.5 7.5 0 1 1 17 6.4 M19.8 3.6 V8.4 H15"; }
        if (name == "check") { return "M5 12.5 L9.8 17 L19 7.2"; }
        if (name == "sun") { return "M8 12 A4 4 0 1 0 16 12 A4 4 0 1 0 8 12 M12 2.5 V4.5 M12 19.5 V21.5 M2.5 12 H4.5 M19.5 12 H21.5 M5.3 5.3 L6.7 6.7 M17.3 17.3 L18.7 18.7 M5.3 18.7 L6.7 17.3 M17.3 6.7 L18.7 5.3"; }
        if (name == "moon") { return "M19.5 14.6 A8 8 0 1 1 9.4 4.5 A6.4 6.4 0 0 0 19.5 14.6 Z"; }
        if (name == "trash") { return "M5 7 H19 M9.5 7 V4.8 H14.5 V7 M7 7 L8 19.5 H16 L17 7"; }
        return "";
    }
}

export component Icon {
    in property <string> name;
    in property <color> color: #a4aaaf;
    in property <length> size: 20px;
    in property <length> line: 1.8px;
    width: size;
    height: size;

    if IconSet.fill(root.name) != "": Path {
        width: root.size;
        height: root.size;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: IconSet.fill(root.name);
        fill: root.color;
    }
    if IconSet.stroke(root.name) != "": Path {
        width: root.size;
        height: root.size;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: IconSet.stroke(root.name);
        stroke: root.color;
        stroke-width: root.line;
        stroke-line-cap: round;
        fill: transparent;
    }
}
